{"version": 2, "width": 100, "height": 32, "timestamp": 1793692815, "env": {"SHELL": "/bin/bash", "TERM": "linux"}}
[0.011619, "o", "\u001b[H\u001b[J\u001b[3J\u001b[1mc2sink — passive sinkhole for a BGP C2 blackhole feed\u001b[0m\r\n"]
[0.012569, "o", "\u001b[2man ISP blackholes a C2 prefix; this recovers WHICH customers are infected\u001b[0m\r\n\r\n"]
[2.014293, "o", "\u001b[1;36m# The feed: the blackholed C2 destinations, with the labels the feed already has.\u001b[0m\r\n"]
[2.016878, "o", "\u001b[1;32m$ cat examples/_demo_feed.txt\u001b[0m\r\n"]
[2.01834, "o", "127.0.3.10  ExampleLoader\r\n127.0.3.20  ExampleStealer\r\n127.0.3.30  ExampleProxy\r\n"]
[4.021107, "o", "\u001b[1;36m# Start the sinkhole. It listens, records, and never answers a client.\u001b[0m\r\n"]
[4.127645, "o", "c2sink listening on ('127.0.0.1', 18443); feed entries: 3\r\n"]
[6.227579, "o", "\u001b[1;36m# Point the blackholed prefixes at the sink (what an edge router/ExaBGP does).\u001b[0m\r\n\u001b[1;32m$ iptables -t nat -A OUTPUT -p tcp -d 127.0.3.0/24 --dport 443 -j REDIRECT --to-ports 18443\u001b[0m\r\n"]
[8.032457, "o", "\u001b[1;36m# Now three infected 'subscribers' beacon to those dead C2s (synthetic, loopback only).\u001b[0m\r\n"]
[8.162957, "o", "   5 connections sent; each got 0 bytes back from the sink.\r\n"]
[11.183607, "o", "\u001b[1;36m# Report 1 — for the ISP abuse desk: which customers are infected, and what they are.\u001b[0m\r\n\u001b[1;32m$ PYTHONPATH=. python -m c2sink report --log examples/_demo_events.jsonl\u001b[0m\r\n"]
[11.265214, "o", "Infected-subscriber report (passive sinkhole)\r\n====================================================\r\nsubscribers that contacted a C2: 3\r\n\r\n127.0.1.11\r\n  connections : 3\r\n  window      : 2026-11-03 08:00:24Z .. 2026-11-03 08:00:24Z\r\n  c2 targets  : 127.0.3.10, 127.0.3.30\r\n  feed labels : ExampleLoader, ExampleProxy\r\n  tls sni     : api.exampleloader.cc, cdn.exampleproxy.to\r\n  ja3         : 28c903ee7c6f177a22c909a6806c1a63\r\n\r\n127.0.1.12\r\n  connections : 1\r\n  window      : 2026-11-03 08:00:24Z .. 2026-11-03 08:00:24Z\r\n  c2 targets  : 127.0.3.20\r\n  feed labels : ExampleStealer\r\n  http host   : panel.examplestealer.su\r\n  user-agent  : Mozilla/4.0 (compatible)\r\n\r\n127.0.1.13\r\n  connections : 1\r\n  window      : 2026-11-03 08:00:24Z .. 2026-11-03 08:00:24Z\r\n  c2 targets  : 127.0.3.30\r\n  feed labels : ExampleProxy\r\n  ja3         : 77632da2117ede28f6b81655da556726\r\n\r\n"]
[14.279869, "o", "\u001b[1;36m# Report 2 — for the feed operator: which listed C2s are live, and false-positive signals.\u001b[0m\r\n\u001b[1;32m$ PYTHONPATH=. python -m c2sink report --log examples/_demo_events.jsonl --health\u001b[0m\r\n"]
[14.365234, "o", "Feed-health report (what the sinkhole sees per listed destination)\r\n==================================================================\r\nlisted destinations with traffic: 3\r\n\r\n127.0.3.10  [ExampleLoader]  LIVE\r\n  hits / subscribers : 2 / 1\r\n  last contact       : 2026-11-03 08:00:24Z  (0.0 h ago)\r\n  names seen         : api.exampleloader.cc\r\n\r\n127.0.3.30  [ExampleProxy]  LIVE\r\n  hits / subscribers : 2 / 2\r\n  last contact       : 2026-11-03 08:00:24Z  (0.0 h ago)\r\n  names seen         : cdn.exampleproxy.to\r\n\r\n127.0.3.20  [ExampleStealer]  LIVE\r\n  hits / subscribers : 1 / 1\r\n  last contact       : 2026-11-03 08:00:24Z  (0.0 h ago)\r\n  names seen         : panel.examplestealer.su\r\n\r\n"]
[17.38106, "o", "\r\n\u001b[1mThe blackhole still drops the traffic. The sinkhole tells you who, what and whether the entry is still worth listing.\u001b[0m\r\n"]

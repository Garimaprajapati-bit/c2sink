{"version": 2, "width": 100, "height": 34, "timestamp": 1793741020, "env": {"SHELL": "/bin/bash", "TERM": "linux"}}
[0.016073, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.016807, "o", "\u001b[1mc2sink — passive sinkhole for a BGP C2 blackhole feed\u001b[0m\r\n\u001b[2man ISP blackholes a C2 prefix; this recovers WHICH customers are infected\u001b[0m\r\n\r\n"]
[2.028131, "o", "\u001b[1;36m# The feed: the blackholed C2 destinations, with the labels the feed already has.\u001b[0m\r\n"]
[2.030439, "o", "\u001b[1;32m$ cat examples/_demo_feed.txt\u001b[0m\r\n"]
[2.031954, "o", "127.0.3.10  ExampleLoader\r\n127.0.3.20  ExampleStealer\r\n127.0.3.30  ExampleProxy\r\n"]
[4.035797, "o", "\u001b[1;36m# Start the sinkhole. It listens, records, and never answers a client.\u001b[0m\r\n"]
[4.14099, "o", "c2sink listening on ('127.0.0.1', 18443); feed entries: 3\r\n"]
[6.241901, "o", "\u001b[1;36m# Point the blackholed prefixes at the sink (what an edge router/ExaBGP does).\u001b[0m\r\n\u001b[1;32m$ iptables -t nat -A OUTPUT -p tcp -d 127.0.3.0/24 --dport 443 -j REDIRECT --to-ports 18443\u001b[0m\r\n"]
[8.049491, "o", "\u001b[1;36m# Now three infected 'subscribers' beacon to those dead C2s (synthetic, loopback only).\u001b[0m\r\n"]
[8.143383, "o", "   5 connections sent; each got 0 bytes back from the sink.\r\n"]
[11.164838, "o", "\u001b[1;36m# Intelligence 1 — feed health: which listed C2s are still live (what the operator cares about).\u001b[0m\r\n\u001b[1;32m$ PYTHONPATH=. python -m c2sink report --log examples/_demo_events.jsonl --health\u001b[0m\r\n"]
[11.269173, "o", "Feed-health report (what the sinkhole sees per listed destination)\r\n==================================================================\r\nlisted destinations with traffic: 3\r\n\r\n127.0.3.10  [ExampleLoader]  LIVE\r\n  hits / subscribers : 2 / 1\r\n  last contact       : 2026-11-03 21:23:48Z  (0.0 h ago)\r\n  names seen         : api.exampleloader.cc\r\n\r\n127.0.3.30  [ExampleProxy]  LIVE\r\n  hits / subscribers : 2 / 2\r\n  last contact       : 2026-11-03 21:23:48Z  (0.0 h ago)\r\n  names seen         : cdn.exampleproxy.to\r\n\r\n127.0.3.20  [ExampleStealer]  LIVE\r\n  hits / subscribers : 1 / 1\r\n  last contact       : 2026-11-03 21:23:48Z  (0.0 h ago)\r\n  names seen         : panel.examplestealer.su\r\n\r\n"]
[14.287108, "o", "\u001b[1;36m# Intelligence 2 — client fingerprint: JA4 identifies the malware's TLS stack across IPs/SNIs.\u001b[0m\r\n\u001b[1;32m$ PYTHONPATH=. python -m c2sink report --log examples/_demo_events.jsonl | grep -A6 127.0.1.13\u001b[0m\r\n"]
[14.390414, "o", "127.0.1.13\r\n  connections : 1\r\n  window      : 2026-11-03 21:23:48Z .. 2026-11-03 21:23:48Z\r\n  c2 targets  : 127.0.3.30\r\n  feed labels : ExampleProxy\r\n  ja4         : t13i0505h2_8d80437dd348_0d385148b956\r\n  ja3         : ed8b5be1d20e0b70ea77f42dcaefec32\r\n"]
[17.410593, "o", "\u001b[1;36m# Intelligence 3 — beaconing: regular call-home timing (on a timed sample).\u001b[0m\r\n\u001b[1;32m$ PYTHONPATH=. python -m c2sink report --log examples/beacon_sample.jsonl --beacons\u001b[0m\r\n"]
[17.49362, "o", "Beaconing (regular automated call-home patterns)\r\n================================================\r\n\r\n100.64.12.37 -> 203.0.113.10  [ExampleLoader]\r\n  6 contacts, every ~300s (jitter 0%)\r\n  2026-11-02 06:13:20Z .. 2026-11-02 06:38:20Z\r\n\r\n"]
[20.510304, "o", "\r\n\u001b[1mThe blackhole still drops the traffic. The sinkhole turns it into live feed intelligence: which C2s are active, what the clients are, and how they beacon.\u001b[0m\r\n"]
